{
  "id": "root",
  "type": "column",
  "background": "canvas",
  "terminal_padding": [14, 12],
  "preview": "layouts/job-quest.svg",
  "children": [
    {
      "id": "jq-bar",
      "type": "block",
      "content": { "mod": "job-quest", "props": { "part": "bar" } },
      "size": { "px": 44 },
      "background": "chrome"
    },
    {
      "id": "jq-body",
      "type": "row",
      "padding": 12,
      "gap": 12,
      "children": [
        {
          "id": "jq-view",
          "type": "stack",
          "active": "jq-pipeline",
          "children": [
            {
              "id": "jq-pipeline",
              "type": "row",
              "gap": 12,
              "children": [
                {
                  "id": "jq-board",
                  "type": "block",
                  "content": { "mod": "job-quest", "props": { "part": "board" } },
                  "min": 240,
                  "background": "surface",
                  "border": { "width": 1, "color": "border" },
                  "radius": 12
                },
                {
                  "id": "jq-detail",
                  "type": "block",
                  "content": { "mod": "job-quest", "props": { "part": "detail" } },
                  "size": { "px": 520 },
                  "min": 320,
                  "max": 1200,
                  "background": "surface",
                  "border": { "width": 1, "color": "border" },
                  "radius": 12
                }
              ]
            },
            {
              "id": "jq-profile",
              "type": "block",
              "content": { "mod": "job-quest", "props": { "part": "profile" } },
              "background": "surface",
              "border": { "width": 1, "color": "border" },
              "radius": 12
            },
            {
              "id": "jq-intake",
              "type": "block",
              "content": { "mod": "job-quest", "props": { "part": "intake" } },
              "background": "surface",
              "border": { "width": 1, "color": "border" },
              "radius": 12
            },
            {
              "id": "jq-terminals",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 10,
                  "background": "background",
                  "border": { "width": 1, "color": "border" },
                  "focus": { "width": 1, "color": "accent" },
                  "lone": true
                }
              }
            }
          ]
        },
        {
          "id": "jq-agent",
          "type": "block",
          "content": { "agent": "focused" },
          "size": { "px": 520 },
          "min": 280,
          "max": 1600,
          "hidden": true,
          "background": "background",
          "border": { "width": 1, "color": "border" },
          "radius": 12
        }
      ]
    },
    {
      "id": "jq-status",
      "type": "block",
      "content": { "mod": "workspace-status" },
      "size": { "px": 28 }
    }
  ]
}
